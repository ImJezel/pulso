# Copia este archivo como .env.local y llena los dos valores con los de tu
# proyecto de Supabase (Project Settings → API). La clave "publishable" (o la
# "anon" heredada) es pública por diseño: lo que protege los datos es Row Level
# Security en la base de datos, no esconder esta clave.
#
# Si dejas estas variables vacías, Pulso funciona en modo local: sin cuentas y
# con los datos solo en este navegador.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Solo para la CLI de Supabase (npx supabase db push). Nunca la uses en el
# navegador y nunca la subas al repositorio.
SUPABASE_DB_PASSWORD=
