{
  "name": "pulso",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "capturas": "node scripts/capturas.mjs",
    "axe": "node scripts/axe.mjs",
    "recorrido": "node scripts/recorrido.mjs",
    "verificar": "npm test && npm run build && npm run axe && npm run recorrido",
    "build:unico": "tsc -b && vite build --mode unico"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "description": "Pulso — control de tratamiento para personas con hipertensión y diabetes tipo 2. ITLA · Interacción Humano-Computadora."
}
